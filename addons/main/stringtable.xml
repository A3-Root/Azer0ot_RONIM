        <Key ID="STR_azeroot_ronim_main_debugLog">
            <English>RPT logging</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_debugLog_desc">
            <English>Write RONIM events (mount failures, bruises, overrides) to the RPT log.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_debugOverlay">
            <English>Debug overlay</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_debugOverlay_desc">
            <English>Show RONIM's current state on screen (local player).</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_exempt">
            <English>RONIM Exempt Units</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_exempt_desc">
            <English>Synced units (or all units of synced groups) are exempt from every RONIM effect.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_exempt_value">
            <English>Exempt</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_exempt_value_desc">
            <English>On = exempt, Off = remove an exemption.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_settings">
            <English>RONIM Settings</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_eden_settings_desc">
            <English>Mission-wide overrides of RONIM's CBA settings. Keep setting leaves a value alone.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_enabled">
            <English>Enable RONIM</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_enabled_desc">
            <English>Master switch for every RONIM effect.\nOff = vanilla night vision.</English>
        </Key>
