        <Key ID="STR_azeroot_ronim_main_flashDuration">
            <English>Bloom duration</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashDuration_desc">
            <English>Seconds the bloom takes to fade.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashEnabled">
            <English>Muzzle flash bloom</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashEnabled_desc">
            <English>Firing without a suppressor washes the NVG image out white for a moment.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashIntensity">
            <English>Bloom intensity</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashIntensity_desc">
            <English>How white the image gets on a shot.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearby">
            <English>Nearby shooters</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearbyRange">
            <English>Nearby range</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearbyRange_desc">
            <English>Distance in metres within which other shooters cause bloom. Fades with distance.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearbyScale">
            <English>Nearby intensity</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearbyScale_desc">
            <English>Bloom from another shooter at point blank, relative to your own shot.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashNearby_desc">
            <English>Unsuppressed shots from other units close to you and in view also bloom your NVGs.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashRequireMagnified">
            <English>Only through magnified optics</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashRequireMagnified_desc">
            <English>Bloom only while aiming through a magnified optic.\nOff = any shot with NVGs on.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashStack">
            <English>Follow-up shot bloom</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_flashStack_desc">
            <English>Share of full bloom that a shot adds while the previous bloom is still fading (automatic fire).</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_integratedBlacklist">
            <English>Never integrated</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_integratedBlacklist_desc">
            <English>Optics never treated as integrated NV, even if auto-detection says so.\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_integratedWhitelist">
            <English>Integrated NV optics</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_integratedWhitelist_desc">
            <English>Optics (or weapons with built-in optics) treated as having their own night vision: no optic features.\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_category">
            <English>RONIM</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_down">
            <English>Mask calibration: down</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_left">
            <English>Mask calibration: left</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_narrower">
            <English>Mask calibration: narrower</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_reset">
            <English>Mask calibration: reset this NVG</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_right">
            <English>Mask calibration: right</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_scaleDown">
            <English>Mask calibration: smaller</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_scaleUp">
            <English>Mask calibration: bigger</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_up">
            <English>Mask calibration: up</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_kb_wider">
            <English>Mask calibration: wider</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_keep">
            <English>Keep setting</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_magThreshold">
            <English>Magnification threshold</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_magThreshold_desc">
            <English>Zoom at or above which an optic counts as magnified. Optic features (mount failure, bruise, ADS sway,\nmisalignment, flash bloom, monocular reticle) need this. Iron sights and holo sights sit around 1.0-1.3x.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskCalibration">
            <English>Mask calibration</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskCalibration_desc">
            <English>Tube mask size and position per NVG as class:scale:offsetX:offsetY:stretch entries, comma separated.\nScale = mask height in screen heights, offsets in screen fractions, stretch = width multiplier.\nTune in game with the RONIM calibration keybinds (saved per player); the hint shows the entry to paste here.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskEnabled">
            <English>Draw NVG tube mask</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskEnabled_desc">
            <English>Black out everything outside the NVG tube(s) while NVGs are on.\nOff = full screen night vision.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskOpacity">
            <English>Mask opacity</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskOpacity_desc">
            <English>How dark the area outside the tubes is.\nLower = you can see a little around the tubes.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskOverHud">
            <English>Mask in front</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskOverHud_desc">
            <English>Draw the tube overlay over the HUD layer, in front of the NVG's own optic overlay.\nCovers HUD elements in the blacked out area while NVGs are on. Off = under the HUD.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskScale">
            <English>Tube size</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskScale_desc">
            <English>Size of the tube view.\nHigher = larger tubes, less blacked out.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource">
            <English>Tube shape source</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource_desc">
            <English>Where the tube mask's shape comes from.\nAuto: the NVG's own optic overlay texture (from RONIM's NVG compat addons or found next to its modelOptics),\nelse its ACE border texture, else RONIM's.\nSize and position per NVG come from Classes &gt; Mask calibration and the calibration keybinds.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource_opt0">
            <English>Auto</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource_opt1">
            <English>NVG optic texture</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource_opt2">
            <English>ACE border texture</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_maskSource_opt3">
            <English>RONIM generic</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignAutoRecover">
            <English>Auto recover</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignAutoRecover_desc">
            <English>The mount settles back by itself after you stop shooting.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignChance">
            <English>Misalignment chance per shot</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignChance_desc">
            <English>Chance that one shot shifts the mount. Scales with the round's power.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignEnabled">
            <English>Mount misalignment</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignEnabled_desc">
            <English>Shots can shift the NVG mount so the tube sits off centre until it recovers or is re-seated. Only while aiming through a magnified optic (above the General magnification threshold) with NVGs on.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignMax">
            <English>Max misalignment</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignMax_desc">
            <English>Furthest the mount can end up off centre, as a fraction of screen height.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignRecoverDelay">
            <English>Auto recover delay</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignRecoverDelay_desc">
            <English>Seconds without firing before the mount starts settling back.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignRecoverTime">
            <English>Auto recover time</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignRecoverTime_desc">
            <English>Seconds the mount takes to settle fully back once it starts.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignStep">
            <English>Misalignment per shift</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignStep_desc">
            <English>How far one shift moves the tube, as a fraction of screen height.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignToggleReset">
            <English>NVG toggle re-seats</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_misalignToggleReset_desc">
            <English>Turning the NVGs off and on again clears the misalignment.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoCustomMask">
            <English>Custom monocular mask</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoCustomMask_desc">
            <English>Monocular NVGs always use RONIM's monocular mask: one tube in front of the chosen eye, the rest dark,\nwhatever the NVG's own overlay looks like.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoOtherEye">
            <English>Monocular other eye</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoOtherEye_desc">
            <English>What the eye without the tube sees.\nReal view needs PiP night vision; in the game's NVG mode the other eye is always dark.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoOtherEye_opt0">
            <English>Dark</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoOtherEye_opt1">
            <English>Real view (PiP)</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoShift">
            <English>Monocular tube shift</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoShift_desc">
            <English>How far a monocular tube sits off centre, as a fraction of screen width.\n0 = centred.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoSide">
            <English>Monocular eye</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoSide_desc">
            <English>Which eye a monocular NVG sits in front of.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoSide_opt0">
            <English>Left eye</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_monoSide_opt1">
            <English>Right eye</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountBrokenHint">
            <English>Your NVG mount broke - the goggles fell off.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountChance">
            <English>Failure chance per shot</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountChance_desc">
            <English>Chance that one shot breaks the mount.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountEnabled">
            <English>Mount failure</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountEnabled_desc">
            <English>Shots can break the NVG mount so the goggles fall to the ground. Only while aiming through a magnified optic (above the General magnification threshold) with NVGs on.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountNotify">
            <English>Notify player</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountNotify_desc">
            <English>Show a hint when your NVGs fall off.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountRecoilScale">
            <English>Scale with recoil</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_mountRecoilScale_desc">
            <English>Powerful rounds (7.62, .338, .50) break mounts more often than 5.56 or pistol rounds.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgApplied">
            <English>RONIM overrides applied</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgBroken">
            <English>NVG mount broken</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgCleared">
            <English>RONIM overrides cleared</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgExemptOff">
            <English>Unit no longer exempt</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgExemptOn">
            <English>Unit exempt from RONIM</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgFeatures">
            <English>RONIM features updated</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgNeedUnit">
            <English>Place the module on a unit</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgNoNvg">
            <English>Unit has no NVGs</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgOptics">
            <English>Integrated NV optics updated</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_msgReseated">
            <English>NVG mount re-seated</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgBino">
            <English>Binocular NVGs</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgBino_desc">
            <English>NVG classes forced to two tubes.\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgIgnore">
            <English>Ignored NVGs</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgIgnore_desc">
            <English>NVG / HMD classes RONIM leaves alone entirely (no mask, no features).\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgImmune">
            <English>Unbreakable mounts</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgImmune_desc">
            <English>NVG classes that never fall off (mount failure).\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgMono">
            <English>Monocular NVGs</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgMono_desc">
            <English>NVG classes forced to one tube.\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgQuad">
            <English>Panoramic (quad) NVGs</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_nvgQuad_desc">
            <English>NVG classes forced to four tubes.\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_off">
            <English>Off</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_on">
            <English>On</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticModelScale">
            <English>Optic overlay scale</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticModelScale_desc">
            <English>Screen heights per optic model unit, used to size NVG overlays from their real model geometry (NVG compat addons).\nCalibrate one NVG, then every NVG overlay is sized correctly relative to it. The calibration hint shows the value.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsAdd">
            <English>Add classes</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsAdd_desc">
            <English>Comma separated optic classes to treat as integrated NV.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsCurrent">
            <English>Use the unit's current optic</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsCurrent_desc">
            <English>Module placed on a unit: add the optic on its current weapon.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsRemove">
            <English>Remove classes</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_opticsRemove_desc">
            <English>Comma separated optic classes to remove again.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pickCategory">
            <English>Settings group</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipEnabled">
            <English>PiP night vision</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipEnabled_desc">
            <English>In first person, RONIM renders the night vision itself in a picture-in-picture view inside the tubes and keeps\nthe game's own NVG mode off (no vanilla/ACE tube overlay). A monocular leaves the other eye with the real view.\nNeeds PiP enabled in video options. Third person and disabled PiP fall back to the game's NVG mode.\nOff = the game's NVG mode with RONIM's tube overlay drawn in front of it.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipForwardAds">
            <English>Camera offset (aiming)</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipForwardAds_desc">
            <English>Metres the night vision camera sits ahead of the optic while aiming, past the scope body.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipForwardHip">
            <English>Camera offset (hip)</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipForwardHip_desc">
            <English>Metres the night vision camera sits ahead of your eye when not aiming, so it does not see the inside of the\ngoggles or helmet.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipFovScale">
            <English>PiP field of view</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipFovScale_desc">
            <English>Fine-tunes the night vision picture's field of view against the real view.\nAbove 1 = wider, below 1 = narrower.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipResolution">
            <English>PiP resolution</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipResolution_desc">
            <English>Render resolution of the night vision picture.\nHigher = sharper, costs more FPS.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipResolution_opt0">
            <English>512</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipResolution_opt1">
            <English>1024</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_pipResolution_opt2">
            <English>2048</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_recoilCamShake">
            <English>Recoil camera shake</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_recoilCamShake_desc">
            <English>Extra camera shake per shot while aiming with NVGs.\n0 = off.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_recoilKick">
            <English>Recoil kick</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_recoilKick_desc">
            <English>How hard each shot knocks the tube. Scales with the round's power.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseat">
            <English>Re-seat NVG mount</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatAction">
            <English>ACE re-seat action</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatAction_desc">
            <English>Only with ACE: self-interaction &gt; Equipment &gt; Re-seat NVG mount, shown while misaligned.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatTime">
            <English>Re-seat time</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatTime_desc">
            <English>Seconds the ACE re-seat action takes.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseated">
            <English>NVG mount re-seated.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseating">
            <English>Re-seating NVG mount...</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor">
            <English>Reticle colour</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor_desc">
            <English>Colour of the reticle copy.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor_opt0">
            <English>Red</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor_opt1">
            <English>Green</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor_opt2">
            <English>Amber</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleColor_opt3">
            <English>Black</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleEnabled">
            <English>Reticle over night vision</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleEnabled_desc">
            <English>PiP: the night vision picture covers the scope, so a copy of the optic's reticle is drawn at the aim point on\ntop of it. Tube sway and misalignment move the picture against it. Only while aiming through a magnified optic (above the General magnification threshold) with NVGs on.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleMap">
            <English>Reticle per optic</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleMap_desc">
            <English>Monocular reticle per optic as class:style pairs, styles dot, cross, chevron, mildot.\nExample: optic_Hamr:chevron, optic_Arco:chevron, optic_MRCO:dot</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleOffset">
            <English>Reticle offset</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleOffset_desc">
            <English>Monocular side copy: horizontal distance from screen centre, as a fraction of screen width.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleOpacity">
            <English>Reticle opacity</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleOpacity_desc">
            <English>How visible the reticle copy is.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleSideCopy">
            <English>Monocular side copy</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleSideCopy_desc">
            <English>Game NVG mode only (PiP off / third person): with a monocular, draw a copy of the reticle on the side\nwithout the tube.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleSize">
            <English>Reticle size</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleSize_desc">
            <English>Reticle size as a fraction of screen height.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle">
            <English>Default reticle</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle_desc">
            <English>Reticle drawn when the optic has no entry in Classes &gt; Reticle per optic.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle_opt0">
            <English>Dot</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle_opt1">
            <English>Cross</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle_opt2">
            <English>Chevron</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reticleStyle_opt3">
            <English>Mil-dot</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorAudible">
            <English>Suppressor detection</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorAudible_desc">
            <English>Muzzle attachments that cut sound below this value count as suppressors. Flash hiders and brakes do not.\nClasses &gt; suppressor lists override this.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorBlacklist">
            <English>Never suppressor</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorBlacklist_desc">
            <English>Muzzle attachments never counted as suppressors (bloom).\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorWhitelist">
            <English>Always suppressor</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_suppressorWhitelist_desc">
            <English>Muzzle attachments always counted as suppressors (no bloom).\nComma separated classnames, case insensitive.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayDamping">
            <English>Mount damping</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayDamping_desc">
            <English>How quickly wobbles die out.\nHigher = settles fast. Lower = keeps bouncing.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayEnabled">
            <English>Tube sway</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayEnabled_desc">
            <English>The tube view lags and bobs with head movement, walking and fatigue.\nOff = tube fixed to the screen centre.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayFatigue">
            <English>Fatigue effect</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayFatigue_desc">
            <English>Extra drift when tired.\n0 = fatigue has no effect.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayIdle">
            <English>Idle drift</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayIdle_desc">
            <English>Slow drift while standing still.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayLook">
            <English>Head turn lag</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayLook_desc">
            <English>How much the tube lags behind when you turn your head.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayMaxOffset">
            <English>Max sway offset</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayMaxOffset_desc">
            <English>Furthest the tube may sway from centre, as a fraction of screen height.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayMove">
            <English>Walking bob</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayMove_desc">
            <English>How much the tube bobs while moving. Scales with speed, less when crouched or prone.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayStiffness">
            <English>Mount stiffness</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayStiffness_desc">
            <English>How firmly the mount pulls the tube back to centre.\nHigher = snappier, smaller swings. Lower = looser, wobblier.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayStrength">
            <English>Sway strength</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_swayStrength_desc">
            <English>Overall multiplier for all tube sway.\n2.0 = twice the movement, 0.5 = half.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_breakMount">
            <English>Break NVG Mount</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_exempt">
            <English>Toggle Exempt</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_features">
            <English>Toggle Features</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_optics">
            <English>Integrated NV Optics</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_reseat">
            <English>Re-seat NVG Mount</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_zeus_settings">
            <English>RONIM Settings</English>
        </Key>
    </Package>
</Project>
