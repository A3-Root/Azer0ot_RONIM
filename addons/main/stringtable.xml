            <English>How hard each shot knocks the tube. Scales with the round's power.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseat">
            <English>Re-seat NVG mount</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatAction">
            <English>ACE re-seat action</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatAction_desc">
            <English>Only with ACE: self-interaction &gt; Equipment &gt; Re-seat NVG mount, shown while misaligned.</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatTime">
            <English>Re-seat time</English>
        </Key>
        <Key ID="STR_azeroot_ronim_main_reseatTime_desc">
